<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 et plus : sauvegarde dans le nuage et transfert vers un nouveau téléphone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saves/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="saves/" />
    </device-transfer>
</data-extraction-rules>
